<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        %clr(...) 不是 Logback 原生语法，而是 Spring Boot 提供的颜色转换器。
        spring.output.ansi.enabled 决定是否真正输出 ANSI 颜色码；具体配色仍由 YAML Pattern 决定。
    -->
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>

    <!--
        日志格式与根级别属于运行配置：开发环境可更详细、生产环境可更克制。
        springProperty 从 application*.yaml 的 logging.pattern.console / logging.level.root 读取，
        因此 XML 只保留日志结构，不再固化任何环境值。
    -->
    <springProperty scope="context" name="CONSOLE_LOG_PATTERN" source="logging.pattern.console"/>
    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>m p


    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- 当前日志和历史日志统一保存到固定目录。 -->
        <file>/Users/xiongtao/Documents/logs/spring-feature-collection/application.log</file>

        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
<!--            <fileNamePattern>-->
<!--                logs/spring-feature-collection.%d{yyyy-MM-dd}.%i.log.gz-->
<!--            </fileNamePattern>-->

            <!-- 历史日志也固定保存在这个目录 -->
            <fileNamePattern>
                /Users/xiongtao/Documents/logs/spring-feature-collection/application.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- 单个日志文件最大 100MB -->
            <maxFileSize>100MB</maxFileSize>

            <!-- 日志最多保留 30 天 -->
            <maxHistory>30</maxHistory>

            <!-- 所有日志文件总大小最多 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE"/>
    </root>
</configuration>
