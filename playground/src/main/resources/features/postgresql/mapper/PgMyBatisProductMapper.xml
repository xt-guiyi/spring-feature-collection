<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xt.xiaoxingxing.playground.features.postgresql.mapper.PgMyBatisProductMapper">

    <!-- CRUD 共用列清单，后续增加字段时只需维护一处。 -->
    <sql id="productColumns">
        id, name, price, stock
    </sql>

    <!-- PostgreSQL RETURNING 让 INSERT 在同一次数据库往返中返回自增主键。 -->
    <select id="insertProduct"
            parameterType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct"
            resultType="java.lang.Long"
            affectData="true"
            flushCache="true">
        INSERT INTO products (name, price, stock)
        VALUES (#{name}, #{price}, #{stock})
        RETURNING id
    </select>

    <select id="selectProductById" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct">
        SELECT <include refid="productColumns"/>
        FROM products
        WHERE id = #{id}
    </select>

    <select id="selectAllProducts" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct">
        SELECT <include refid="productColumns"/>
        FROM products
        ORDER BY id ASC
    </select>

    <!-- 一次 IN 查询批量加载下单涉及的商品，避免逐商品查询产生 N+1。 -->
    <select id="selectProductsByIds" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct">
        SELECT <include refid="productColumns"/>
        FROM products
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY id ASC
    </select>

    <!--
        choose 保证价格上下界同时存在时明确演示 BETWEEN；只传一侧时退化为 >= 或 <=。
        BETWEEN 包含上下边界，等价于 price >= minPrice AND price <= maxPrice。
    -->
    <select id="selectProductsByCondition"
            parameterType="com.xt.xiaoxingxing.playground.features.postgresql.dto.request.ProductQueryRequest"
            resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct">
        SELECT <include refid="productColumns"/>
        FROM products
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <choose>
                <when test="minPrice != null and maxPrice != null">
                    AND price BETWEEN #{minPrice} AND #{maxPrice}
                </when>
                <otherwise>
                    <if test="minPrice != null">AND price &gt;= #{minPrice}</if>
                    <if test="maxPrice != null">AND price &lt;= #{maxPrice}</if>
                </otherwise>
            </choose>
            <if test="minStock != null">AND stock &gt;= #{minStock}</if>
        </where>
        ORDER BY price DESC, id ASC
    </select>

    <!-- 动态 set 只更新非空字段；数值合法性由两套 Service 在进入 Mapper 前统一校验。 -->
    <update id="updateProduct" parameterType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgProduct">
        UPDATE products
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteProductById">
        DELETE FROM products WHERE id = #{id}
    </delete>

    <!--
        把 stock >= quantity 放进 UPDATE 条件，使检查和扣减成为一条原子 SQL。
        并发请求中只有库存仍充足的事务能影响一行，Service 据此判断库存是否不足。
    -->
    <update id="decrementStock">
        UPDATE products
        SET stock = stock - #{quantity}
        WHERE id = #{productId}
          AND stock &gt;= #{quantity}
    </update>

</mapper>
