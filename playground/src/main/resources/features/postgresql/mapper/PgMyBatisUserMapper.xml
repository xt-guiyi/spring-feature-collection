<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xt.xiaoxingxing.playground.features.postgresql.mapper.PgMyBatisUserMapper">

    <!--
        统一列清单显式使用别名，把数据库 snake_case 映射为 Java camelCase。
        即使关闭 mapUnderscoreToCamelCase，返回结果也不会受影响。
    -->
    <sql id="userColumns">
        id, username, email, phone, status, created_at AS createdAt
    </sql>

    <!--
        PostgreSQL RETURNING 可以在一次往返中完成插入并返回生成主键。
        affectData="true" 告诉 MyBatis 这条 select 实际会修改数据。
    -->
    <select id="insertUser"
            parameterType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser"
            resultType="java.lang.Long"
            affectData="true"
            flushCache="true">
        INSERT INTO users (username, email, phone, status, created_at)
        VALUES (
            #{username},
            #{email},
            #{phone},
            COALESCE(#{status}, 'ACTIVE'),
            COALESCE(#{createdAt}, CURRENT_TIMESTAMP)
        )
        RETURNING id
    </select>

    <select id="selectUserById" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser">
        SELECT <include refid="userColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="selectAllUsers" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser">
        SELECT <include refid="userColumns"/>
        FROM users
        ORDER BY id ASC
    </select>

    <!--
        set 标签会自动去掉最后一个逗号；if 让 PUT 接口只更新非空字段。
        Service 会在调用前确保至少存在一个可更新字段，避免生成空 SET。
    -->
    <update id="updateUser" parameterType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser">
        UPDATE users
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteUserById">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <!--
        where 标签只在至少一个条件成立时输出 WHERE，并自动移除首个 AND。
        LIKE 与 MyBatis-Plus Wrapper 生成的操作符保持一致；foreach 负责安全生成 IN 占位符。
    -->
    <select id="selectUsersByCondition"
            parameterType="com.xt.xiaoxingxing.playground.features.postgresql.dto.request.UserQueryRequest"
            resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser">
        SELECT <include refid="userColumns"/>
        FROM users
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%')
                    OR email LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="ids != null and ids.size > 0">
                AND id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="phoneIsNull != null and phoneIsNull">
                AND phone IS NULL
            </if>
        </where>
        ORDER BY status ASC, id ASC
    </select>

    <select id="countUsers" resultType="long">
        SELECT COUNT(*) FROM users
    </select>

    <!-- PostgreSQL LIMIT 控制本页条数，OFFSET 跳过前面页的数据。 -->
    <select id="selectUserPage" resultType="com.xt.xiaoxingxing.playground.features.postgresql.entity.PgUser">
        SELECT <include refid="userColumns"/>
        FROM users
        ORDER BY id ASC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- foreach 生成一个 INSERT 的多组 VALUES，比逐行往返数据库更高效。 -->
    <insert id="batchInsertUsers">
        INSERT INTO users (username, email, phone, status, created_at)
        VALUES
        <foreach collection="users" item="user" separator=",">
            (
                #{user.username},
                #{user.email},
                #{user.phone},
                COALESCE(#{user.status}, 'ACTIVE'),
                COALESCE(#{user.createdAt}, CURRENT_TIMESTAMP)
            )
        </foreach>
    </insert>

    <update id="batchUpdateUserStatus">
        UPDATE users
        SET status = #{status}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="batchDeleteUsers">
        DELETE FROM users
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
